# SignSpeak environment variables
#
# Copy this file to `.env.local` and edit as needed:
#
#   cp .env.example .env.local
#
# Every variable is OPTIONAL. The app runs with all of them unset, which is the intended
# default: on-device recognition, no backend, the national emergency number. If a variable
# is missing the app falls back to the default below and tells the user what it is doing
# rather than failing.
#
# Next.js only exposes variables prefixed with NEXT_PUBLIC_ to the browser. Do not put
# secrets in this file — there is nowhere in this application for a secret to go, because
# nothing is authenticated and nothing leaves the device.

# ---------------------------------------------------------------------------------------
# Sign recognition
# ---------------------------------------------------------------------------------------

# Path (relative to the site root) of the exported ONNX classifier.
# The default is the filename `ml/scripts/train.py` writes. If no model exists at this
# path the app says so plainly on the Home, Talk and Limitations screens and offers the
# phrase board, typing and Emergency mode instead. It never pretends to recognise signs.
# Default: /models/sign-clf-v1.onnx
NEXT_PUBLIC_MODEL_URL=/models/sign-clf-v1.onnx

# Path (relative to the site root) of the model card written alongside the model.
# Default: /models/model-card.json
NEXT_PUBLIC_MODEL_CARD_URL=/models/model-card.json

# Directory containing the self-hosted ONNX Runtime Web WASM files.
# `node scripts/setup-assets.mjs` populates it. Self-hosting is what keeps inference
# entirely on the device and avoids a third-party request (docs/privacy-and-safety.md §7).
# Default: /ort
NEXT_PUBLIC_ORT_WASM_PATH=/ort

# Directory containing the self-hosted MediaPipe Tasks Vision WASM files.
# Default: /mediapipe/wasm
NEXT_PUBLIC_MEDIAPIPE_WASM_PATH=/mediapipe/wasm

# MediaPipe model bundle paths. These are Google's hand and pose landmark models, not
# SignSpeak models — see public/models/README.md.
# Defaults: /models/hand_landmarker.task and /models/pose_landmarker_lite.task
NEXT_PUBLIC_HAND_LANDMARKER_MODEL=/models/hand_landmarker.task
NEXT_PUBLIC_POSE_LANDMARKER_MODEL=/models/pose_landmarker_lite.task

# ---------------------------------------------------------------------------------------
# Optional inference backend
# ---------------------------------------------------------------------------------------
#
# A landmark-only WebSocket inference server. ENTIRELY OPTIONAL: leave this unset and
# recognition runs in the browser with onnxruntime-web, which is the privacy-first default
# and needs no server at all. If you set it, the app still prefers on-device inference
# unless the user turns the backend on in Settings, and it falls back to on-device
# inference with a visible notice whenever the server is unreachable.
#
# Only the 159-float feature vector is sent — never frames, images or audio.
# Contract: docs/technical-architecture.md §8.
# Example: wss://signspeak.example.org/infer
NEXT_PUBLIC_INFERENCE_BACKEND_URL=

# ---------------------------------------------------------------------------------------
# Emergency mode
# ---------------------------------------------------------------------------------------

# The number dialled by the one-tap emergency call button.
#
# 112 is the single emergency number for India (police, fire, ambulance) and is the default.
# VERIFY THIS AGAINST LOCAL POLICY BEFORE ANY DEPLOYMENT: a hospital may require its own
# internal emergency extension, and the correct number differs outside India.
# See Q7 in docs/open-questions-and-decisions.md — this is an open decision, not a settled one.
# Default: 112
NEXT_PUBLIC_EMERGENCY_NUMBER=112

# Optional label shown under the emergency button, e.g. "Hospital emergency line".
NEXT_PUBLIC_EMERGENCY_NUMBER_LABEL=

# ---------------------------------------------------------------------------------------
# Capture and performance tuning
# ---------------------------------------------------------------------------------------

# Requested camera capture size. Lower values improve frame rate on low-end phones
# (risk R7). MediaPipe works well at 640x480; going above 1280x720 costs more than it gains.
# Defaults: 640 and 480
NEXT_PUBLIC_CAPTURE_WIDTH=640
NEXT_PUBLIC_CAPTURE_HEIGHT=480

# Below this many frames per second the app shows a performance warning and suggests
# reducing the capture size. Default: 8
NEXT_PUBLIC_LOW_FPS_THRESHOLD=8

# ---------------------------------------------------------------------------------------
# Build-time only
# ---------------------------------------------------------------------------------------

# Set to 1 to build a standard Next.js server bundle instead of the static export.
# The default (unset) produces a static site in `out/`, which is what GitLab Pages serves
# and what allows the app to work with no backend at all.
# SIGNSPEAK_STANDALONE=1

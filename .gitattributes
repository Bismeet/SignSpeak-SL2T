# Normalise line endings in the repository.
#
# Without this, developing on Windows with `core.autocrlf=true` commits CRLF endings, and
# the CI jobs (which run on Linux) then see CRLF in shell snippets, YAML, Python and JSON.
# That produces failures that only reproduce on one machine, which is the worst kind.
#
# Everything is stored with LF in the repository and checked out with LF, so the working
# tree matches CI and the diff is stable across platforms.
* text=auto eol=lf

# Binary files must never be line-ending converted. MediaPipe models and any recorded clip
# are binary; converting them corrupts them.
*.task binary
*.onnx binary
*.wasm binary
*.mp4 binary
*.webm binary
*.ogv binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary

# `package-lock.json` is generated by npm and must be diffed literally.
package-lock.json -diff linguist-generated=true

# Keep the vendored runtime bundles out of language statistics and diffs.
public/ort/** linguist-vendored
public/mediapipe/** linguist-vendored
